{
  "name": "ytagent-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ytagent MCP server - YouTube channel operations for ONE owned channel. Wraps YouTube Data API v3 + YouTube Analytics API v2 as 11 typed MCP tools with a local quota ledger and dry-run/confirm write actions.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "setup-auth": "node dist/scripts/setup-auth.js",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
