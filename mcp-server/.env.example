# ytagent MCP server environment variables.
# ALL of these are optional - the defaults shown in comments are used when unset.

# Data directory for token.json, client_secret.json, quota ledger, channel cache.
# Default: %USERPROFILE%\.ytagent  (or ~/.ytagent)
YTAGENT_DATA_DIR=

# Path to the Google OAuth client secret JSON (Desktop app client).
# Default: <data dir>\client_secret.json
YTAGENT_CLIENT_SECRETS_FILE=

# Daily quota units for the YouTube Data API project. Default: 10000.
# The server refuses to spend past 90% of this number.
YTAGENT_DAILY_QUOTA=10000

# Force the project-audit flag (public uploads allowed?):
#   true  = public uploads are approved
#   false = uploads are locked private by YouTube audit
# Leave empty to let the server learn the real value from the first upload response.
YTAGENT_PROJECT_AUDITED=

# Loopback port used by `npm run setup-auth` for the OAuth redirect. Default: 42813.
YTAGENT_OAUTH_PORT=42813
